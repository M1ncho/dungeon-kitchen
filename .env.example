# ⚠️ DATABASE_URL 과 NEON_AUTH_BASE_URL 은 반드시 "같은 Neon 브랜치"에서 복사할 것.
#    Neon Auth 설정과 유저 데이터는 브랜치 단위다. 개발은 `dev` 브랜치, 배포는 `main` 브랜치.
#    (브랜치가 다르면 가입은 되는데 등록/조회가 어긋난다)

# ── Neon Postgres ──────────────────────────────────────────
# 앱 런타임용 pooled 연결 (호스트에 -pooler 포함).
# 복사 위치: Neon Console > 해당 브랜치 > Connect > "Pooled connection" 체크
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# drizzle-kit 마이그레이션(db:migrate, db:studio)용 direct 연결 (-pooler 없음).
# 복사 위치: 같은 화면에서 "Pooled connection" 체크 해제
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ── Neon Auth ──────────────────────────────────────────────
# Auth URL. 복사 위치: Neon Console > 해당 브랜치 > Auth > Configuration
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth

# 세션 쿠키 서명용 비밀값. 32자 이상 필수. 생성: openssl rand -base64 32
# (앱 시작 시 32자 미만이면 에러로 종료된다. 배포 환경에는 별도 값을 쓸 것)
NEON_AUTH_COOKIE_SECRET=replace-with-output-of-openssl-rand-base64-32

# (선택) Neon Auth 서버 로그 레벨: silent | error | warn(기본) | info | debug
# 가입/로그인이 이상할 때 debug 로 바꾸고 서버 로그를 확인한다.
# NEON_AUTH_LOG_LEVEL=debug

# (선택, 개발·테스트 전용) 의뢰 게시판 시간 배율: 1800 이면 30분 의뢰가 1초 만에 끝난다.
# 배포(production) 환경에는 절대 설정하지 않는다 (설정돼 있으면 앱 시작 시 에러로 막는다).
# REQUEST_TIME_SCALE=1800
